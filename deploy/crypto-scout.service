[Unit]
Description=Crypto Scout - crypto market monitor (monitoring only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptoscout
Group=cryptoscout
WorkingDirectory=/opt/crypto-scout
Environment=CRYPTOSCOUT_DATA_DIR=/var/lib/crypto-scout
Environment=CRYPTOSCOUT_INTERVAL_SECONDS=900
Environment=CRYPTOSCOUT_PAGE_SIZE=100
ExecStart=/opt/crypto-scout/.venv/bin/python -u -m app.scout
Restart=on-failure
RestartSec=30
CPUQuota=30%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crypto-scout

[Install]
WantedBy=multi-user.target
